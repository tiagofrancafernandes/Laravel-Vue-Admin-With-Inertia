{
    "name": "appmaker/appmaker",
    "description": "Full-stack admin panel components for Laravel + Inertia + Vue",
    "type": "library",
    "keywords": [
        "laravel",
        "inertia",
        "vue",
        "admin",
        "crud",
        "resource"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "AppMaker Team",
            "email": "dev@example.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0",
        "illuminate/database": "^11.0",
        "illuminate/http": "^11.0",
        "inertiajs/inertia-laravel": "^1.0|^2.0",
        "tightenco/ziggy": "^2.0",
        "spatie/laravel-permission": "^6.0"
    },
    "require-dev": {
        "laravel/pint": "^1.25",
        "phpunit/phpunit": "^10.0",
        "orchestra/testbench": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "AppMaker\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AppMaker\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AppMaker\\AppMakerServiceProvider"
            ],
            "aliases": {
                "AppMaker": "AppMaker\\Support\\Facades\\AppMaker"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
